{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "balance": { "type": "number", "description": "Current wallet balance" },
        "phoneNumber": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "WalletRequest": {
      "title": "Wallet Request",
      "description": "Requests to charge the user's wallet",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "bank": { "type": "string", "enum": ["bok", "rajhi"] },
        "receiptUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Activity": {
      "title": "Account Activity",
      "description": "History of transactions and status changes",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["charge", "purchase", "refund"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "UserStats": {
      "title": "User Statistics",
      "description": "Historical performance data for a player.",
      "type": "object",
      "properties": {
        "wins": { "type": "integer" },
        "totalGames": { "type": "integer" },
        "currentStreak": { "type": "integer" },
        "longestStreak": { "type": "integer" },
        "lastPlayed": { "type": "string", "format": "date-time" }
      },
      "required": ["wins", "totalGames", "currentStreak", "longestStreak"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders for packages",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "playerId": { "type": "string" },
        "playerName": { "type": "string" },
        "amount": { "type": "integer" },
        "price": { "type": "string" },
        "currency": { "type": "string" },
        "symbol": { "type": "string" },
        "status": { "type": "string", "enum": ["pending_payment", "pending_verification", "processing", "completed", "failed"] },
        "paymentMethod": { "type": "string", "enum": ["stc_pay", "al_rajhi", "binance_pay", "urpay"] },
        "paymentId": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "receiptUrl": { "type": "string", "description": "URL of the uploaded payment receipt image" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "paidAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Users of the application"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Orders made by users"
    },
    "wallet_requests/{requestId}": {
      "schema": "WalletRequest",
      "description": "User requests to charge wallet"
    },
    "activities/{activityId}": {
      "schema": "Activity",
      "description": "User account activity log"
    },
    "stats/{userId}": {
      "schema": "UserStats",
      "description": "Stores performance stats tied to a Google account ID."
    }
  }
}
