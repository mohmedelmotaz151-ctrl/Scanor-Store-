rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------------------------------------
    // GLOBAL HELPERS
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // AUTH TOKENS NEVER CONTAIN ROLES. Explicitly check user doc.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mohmedelmotaz151@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------
    // DEFAULT DENY
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // USERS COLLECTION
    // ---------------------------------------------------------
    function isValidUser(data) {
      return data.uid is string &&
             data.email is string &&
             data.isAdmin is bool &&
             (data.balance is number || !data.keys().hasAll(['balance'])) &&
             data.keys().hasAll(['uid', 'email', 'isAdmin']) &&
             data.keys().size() >= 3;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && (
        incoming().isAdmin == false &&
        (!incoming().keys().hasAll(['balance']) || incoming().balance == 0)
      );
      allow update: if (isOwner(userId) && !incoming().diff(existing()).affectedKeys().hasAny(['isAdmin', 'uid', 'createdAt', 'balance'])) || isAdmin();
    }

    // ---------------------------------------------------------
    // WALLET REQUESTS
    // ---------------------------------------------------------
    function isValidWalletRequest(data) {
      return data.userId == request.auth.uid &&
             data.amount is number && data.amount > 0 &&
             data.status == 'pending' &&
             data.bank in ['bok', 'rajhi'];
    }

    match /wallet_requests/{requestId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && isValidWalletRequest(incoming());
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // ACTIVITIES
    // ---------------------------------------------------------
    match /activities/{activityId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isAdmin(); // Only system/admin can log activities
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // ORDERS COLLECTION
    // ---------------------------------------------------------
    function isValidOrder(data) {
      return data.playerId is string && data.playerId.size() >= 5 && data.playerId.size() <= 50 &&
             data.status in ['pending_payment', 'pending_verification', 'processing', 'completed', 'failed'] &&
             data.price is number && data.price > 0 &&
             data.amount is number && data.amount > 0 &&
             data.bonus is number &&
             data.packageId is string &&
             data.currency in ['SAR', 'SDG'] &&
             data.paymentMethod in ['al_rajhi', 'bok'] &&
             data.email is string && data.email.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20 &&
             data.createdAt == request.time &&
             data.userId is string &&
             data.keys().hasAll(['playerId', 'status', 'price', 'amount', 'bonus', 'packageId', 'currency', 'paymentMethod', 'email', 'phone', 'createdAt', 'userId']) &&
             data.keys().size() == 12;
    }

    match /orders/{orderId} {
      allow read: if isValidId(orderId); // Allow anyone to track by valid ID
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();

      allow create: if isValidId(orderId) && (
        (isSignedIn() && incoming().userId == request.auth.uid) || 
        (incoming().userId == 'guest')
      ) && isValidOrder(incoming());

      allow update: if isValidId(orderId) && isAdmin();
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // ---------------------------------------------------------
    // STATS COLLECTION
    // ---------------------------------------------------------
    function isValidStats(data) {
      return data.wins is int &&
             data.totalGames is int &&
             data.currentStreak is int &&
             data.longestStreak is int &&
             data.keys().hasAll(['wins', 'totalGames', 'currentStreak', 'longestStreak']) &&
             data.keys().size() == 4;
    }

    match /stats/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidStats(incoming());
      allow update: if isOwner(userId) && isValidStats(incoming());
    }
  }
}
